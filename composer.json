{
    "name": "vm-engine/ui-kit",
    "description": "Blade, Alpine and Livewire components that sit next to free Flux: searchable select, date picker, calendar, kanban, uploads, tabs, confirm button, notifications bell, command palette and more",
    "keywords": ["laravel", "livewire", "flux", "blade", "components", "ui"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Achmad Ardiansyah",
            "email": "achmad.ardiansyah@4visionmedia.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "livewire/flux": "^2.20",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "VmEngine\\UiKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VmEngine\\UiKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VmEngine\\UiKit\\UiKitServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
